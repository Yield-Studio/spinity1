  homepage "https://spinity.rocks"

  livecheck do
    url :url
    strategy :github_latest
  end

  app "Spotifast.app"

  zap trash: [
    "~/Library/Application Support/me.paolino.spinity",
    "~/Library/Caches/me.paolino.spinity",
  ]
